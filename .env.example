# Copy to .env and fill secrets locally. Never commit .env.
MODEL_SIZE=4b
MODEL_4B=Qwen/Qwen3.5-4B
MODEL_9B=Qwen/Qwen3.5-9B

# Local serving / TB2
GPU=0
PORT=8200
VLLM_VENV=/fsx/home/jixuan.chen/.venv
TB2_DATASET=terminal-bench@2.0
TB2_API_KEY=EMPTY
TB2_CONCURRENT=5
TB2_MAX_STEPS=120
TB2_TASK_TIMEOUT=900
MAX_MODEL_LEN=32768
GPU_MEMORY_UTILIZATION=0.90

# Harness evolving meta-agent
META_MODEL=openai/gpt-5.5
PROVIDER_ID=openai
GATEWAY_URL=https://gateway.salesforceresearch.ai
OPENAI_API_KEY=
SFG_API_KEY=
NUM_ROUNDS=4
REGRESSION_TOLERANCE=0.0667
REQUIRE_EVIDENCE=0

# SFT (LoRA)
CONDA_SH=/fsx/home/jixuan.chen/miniconda3/etc/profile.d/conda.sh
SFT_CONDA_ENV=vllm-019-cu128-clean
SFT_EPOCHS_4B=3
SFT_EPOCHS_9B=5
SFT_LR_4B=1.0e-5
SFT_LR_9B=1.0e-5
SFT_MAX_SEQ_LENGTH=4096

# Slime replay-GRPO. These paths are installation/checkpoint specific.
SLIME_ROOT=
MEGATRON_ROOT=
DATA_ROOT=
MODEL_ARGS_SCRIPT_4B=
MODEL_ARGS_SCRIPT_9B=
HF_CHECKPOINT_4B=
HF_CHECKPOINT_9B=
REF_LOAD_4B=
REF_LOAD_9B=
NUM_GPUS=8
ACTOR_GPUS=4
ROLLOUT_GPUS=4
TENSOR_MODEL_PARALLEL_SIZE=1
ROLLOUT_GPUS_PER_ENGINE=1
WANDB_MODE=offline
WANDB_KEY=
