\x41\\\\x41\\\\x41\\\\x41\\\\x41\\\\x41\\\\x41\\\\x41\\\\x41\\\\x41\\\\x41\\\\x41\\\\x41' in search_area:\n            print('  Found malicious pattern: ab cd 00 c8 + 41s')\n            pkt_num = count + 1\n            print(f'  This is packet #{pkt_num}')\n        offset += cap_len\n        continue\n    else:\n        offset += cap_len\n\n# Search for the pattern directly\nprint(f'\\\\nSearching for malicious pattern in pcap...')\n# Look for ab cd 00 c8 followed by many 41s\npos = data.find(b'\\\\xab\\\\xcd\\\\x00\\\\xc8')\nwhile pos != -1:\n    next_patch = data[pos+4:]\n    # Count 41s after the c8\n    match = 0\n    for b in next_patch:\n        if b == 0x41:\n            match += 1\n        else:\n            break\n    print(f'Pattern found at position {pos}, followed by {match} bytes of 0x41')\n    pos = data.find(b'\\\\xab\\\\xcd\\\\x00\\\\xc8', pos+1)\n\nEOF"}
