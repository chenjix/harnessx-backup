[36m(LLMRayActor pid=2120836)[0m 2026-09-03 23:54:30 - WARNING - vllm_utils.py:1361 - Step 'bash' timed out after 120.0s. Args: {'command': 'python3 << \'ENDSCRIPT\'\n#!/usr/bin/env python3\nimport cv2\nimport numpy as np\nfrom flask import Flask, request, jsonify\n\napp = Flask(__name__)\n\nP = np.array([[0.8, 0.2, 0.0], [0.0, 0.5, 0.5]])\nframe_tokens = {}\nframe_metrics = None\n\ndef process_video():\n    cap = cv2.VideoCapture(\'/app/experiment_video.mp4\')\n    if not cap.isOpened():\n        raise Exception("Cannot open video")\n    \n    frame_count = 0\n    while True:\n        ret, frame = cap.read()\n        if not ret:\n            break\n        \n        if frame_count % 10 == 0:\n            if len(frame.shape) == 3:\n                r_mean = np.mean(frame[:,:,2])\n                g_mean = np.mean(frame[:,:,1])\n                b_mean = np.mean(frame[:,:,0])\n            elif len(frame.shape) == 2:\n                r_mean = g_mean = b_mean = np.mean(frame)\n            else:\n                raise Exception(f"Unexpected frame shape: {frame.shape}")\n            \n            V = np.array([[r_mean], [g_mean], [b_mean]])\n            T = P @ V\n            t1 = round(float(T[0, 0]), 4)\n            t2 = round(float(T[1, 0]), 4)\n            \n            frame_tokens[frame_count] = [t1, t2]\n            print(f"Frame {frame_count}: T=[{t1}, {t2}]")\n        \n        frame_count += 1\n    \n    cap.release()\n    print(f"Total processed {len(frame_tokens)} frames")\n\ndef setup():\n    global frame_metrics\n    frame_metrics = {}\n    process_video()\n    return frame_metrics\n\n@app.before_request\ndef check_auth():\n    auth = request.headers.get(\'Authorization\', \'\')\n    if auth != \'Bearer RESEARCH_TOKEN_2024\':\n        return jsonify({"error": "Unauthorized"}), 401\n\n@app.route(\'/features/<int:frame_index>\', methods=[\'GET\'])\ndef get_features(frame_index):\n    if frame_index in frame_tokens:\n        return jsonify({"frame": frame_index, "token": frame_tokens[frame_index]})\n    return jsonify({"error": "Frame not found"}), 404\n\n@app.route(\'/validate\', methods=[\'POST\'])\ndef validate():\n    try:\n        data = request.get_json()\n        frame = data[\'frame\']\n        predicted = data[\'predicted_token\']\n    except (KeyError, ValueError):\n        return jsonify({"error": "Invalid JSON"}), 400\n    \n    if frame not in frame_tokens:\n        return jsonify({"error": "Frame not found"}), 404\n    \n    true_token = frame_tokens[frame]\n    error = np.sqrt(sum((np.array(true_token) - np.array(predicted))**2))\n    error = round(error, 4)\n    \n    with open(\'/home/user/experiments.log\', \'a\') as f:\n        f.write(f"Frame {frame}: Error {error}\\n")\n    \n    return jsonify({"status": "logged", "error": error})\n\nif __name__ == \'__main__\':\n    app.run(host=\'127.0.0.1\', port=8055)\nENDSCRIPT'}
