# Copy to configs/tmax.env, fill site-specific values, and never commit it.
# Load with: set -a; source configs/tmax.env; set +a

# Runtime interpreters. Each environment has a different dependency purpose.
PYTHON_BIN=/path/to/vllm-venv/bin/python
VLLM_VENV=/path/to/vllm-venv
SFT_PYTHON=/path/to/sft-venv/bin/python
RL_PYTHON=/path/to/open-instruct/.venv/bin/python

# Model and GPUs.
MODEL_SIZE=9b
GPU_POOL=0,1,2,3,4,5,6,7

# Harness-evolve meta model. Use either Bedrock credentials/profile or the
# gateway variables below; do not put secret values in this tracked template.
META_MODEL=bedrock/us.anthropic.claude-opus-4-8
AWS_REGION_NAME=us-west-2
# AWS_PROFILE=
# OPENAI_API_KEY=
# SFG_API_KEY=
# GATEWAY_URL=https://gateway.salesforceresearch.ai

# External taxonomy data (large/generated data is intentionally not in git).
TAXONOMY_PARQUET=data/external/tmax-taxonomy/data/train-00000-of-00001.parquet

# Safe experiment defaults; override per submission.
TMAX_CONCURRENT=4
HOLDOUT_CONCURRENT=8
TMAX_MAX_STEPS=80
TMAX_MAX_TOKENS=4096
ENABLE_SFT=1
ENABLE_RL=0
SFT_GEN_TASKS=100
WANDB_MODE=offline
